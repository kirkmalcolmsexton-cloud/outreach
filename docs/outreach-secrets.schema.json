{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outreach.local/schemas/outreach-secrets.json",
  "title": "Outreach consolidated secrets",
  "type": "object",
  "additionalProperties": false,
  "required": ["maps_api_key", "google_services"],
  "properties": {
    "maps_api_key": {
      "type": "string",
      "minLength": 1,
      "description": "Google Maps Platform API key for map tiles (same idea as Gradle MAPS_API_KEY)."
    },
    "google_services": {
      "type": "object",
      "description": "Must match the structure of Firebase android/google-services.json.",
      "required": ["project_info", "client"],
      "properties": {
        "project_info": { "type": "object" },
        "client": { "type": "array" },
        "configuration_version": { "type": "string" }
      }
    }
  }
}
