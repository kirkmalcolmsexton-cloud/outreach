# Sourced by start-outreach-emulator.sh.
# Default matches Android Studio on macOS and project local.properties sdk.dir when using $HOME.
# Override in your shell: export ANDROID_HOME=/path/to/sdk

: "${ANDROID_HOME:=${HOME}/Library/Android/sdk}"
: "${ANDROID_SDK_ROOT:=${ANDROID_HOME}}"
export ANDROID_HOME ANDROID_SDK_ROOT
