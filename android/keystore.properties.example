# Copy to android/keystore.properties (gitignored).
#
# CI parity (same signing + secrets as GitHub Actions): do NOT rely on this file — run from repo root:
#   OUTREACH_SECRETS_PASSPHRASE=... bash android/scripts/build.sh release-bundle
# That decrypts secrets/upload-keystore.jks.age, runs setup-secrets.sh, then ./gradlew bundleRelease.
#
# This file is only for optional Gradle-only ./gradlew bundleRelease (e.g. offline). It must point at the
# same upload keystore as CI if you expect identical OAuth SHA-1 / Firebase behavior.
#
# Paths below are relative to this file's directory (android/).
#
# storeFile=upload-keystore.jks
# storePassword=
# keyAlias=upload
# keyPassword=
